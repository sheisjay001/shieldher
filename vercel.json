{
  "version": 2,
  "builds": [
    {
      "src": "shieldher-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "shieldher-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "shieldher-frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "shieldher-backend/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "shieldher-frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)\\.(js|css|ico|svg|png|jpg|jpeg|webp)",
      "dest": "shieldher-frontend/dist/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "shieldher-frontend/dist/index.html"
    }
  ]
}
